---
import '../styles/global.css';

// 1. بيانات المشاريع
const projects = [
  {
    title: "المنصة الإلكترونية الذكية (My Store & Telegram)",
    description: "متجر إلكتروني متكامل باستخدام Django مع ربط مباشر ومؤتمت لتنبيهات الطلبات والفواتير عبر Telegram API.",
    tags: ["Python", "Django", "Telegram API", "SQLite/PostgreSQL"],
    link: "https://github.com/zaid2025026/my_store",
    icon: "🛒"
  },
  {
    title: "نظام الرقابة وتقييم الائتمان (Credit Risk System)",
    description: "تصميم ونمذجة نظام بنكي لتحليل الجدارة الائتمانية ومراقبة القروض المتعثرة بناءً على المؤشرات المالية وقواعد البيانات.",
    tags: ["SQL", "PL/SQL", "Oracle APEX", "Risk Analysis"],
    link: "https://github.com/zaid2025026",
    icon: "🏦"
  },
  {
    title: "المساعد الآلي السحابي (Cloud Automated Bot)",
    description: "تطوير ونشر بوت آلي على بيئة Replit يعمل على مدار الساعة لجلب وجدولة البيانات وإرسال التحديثات آلياً.",
    tags: ["Python", "Replit", "Automation", "RSS Parsers"],
    link: "https://github.com/zaid2025026",
    icon: "🤖"
  }
];

// 2. بيانات الخدمات
const services = [
  {
    title: "تطوير تطبيقات الويب والأنظمة",
    desc: "بناء منصات ويب آمنة ومخصصة بأعلى مستويات الأداء باستخدام Python و Django مع لوحات تحكم متكاملة.",
    icon: "🌐"
  },
  {
    title: "أتمتة الأعمال وبناء البوتات والذكاء الاصطناعي",
    desc: "ربط الخدمات والمتاجر ببوتات تفاعلية ذكية (تليجرام/واتساب) والرد الآلي باستخدام الذكاء الاصطناعي لتوفير الجهد والوقت.",
    icon: "⚡"
  },
  {
    title: "هندسة وإدارة قواعد البيانات",
    desc: "تصميم الاستعلامات المعقدة وتطوير معمارية قواعد البيانات (SQL / PL-SQL) للأنظمة المالية والإدارية.",
    icon: "📊"
  },
  {
    title: "استشارات الأنظمة التقنية والمالية",
    desc: "تقييم المتطلبات البرمجية واختيار المعمارية الأنسب لمشروعك قبل البدء للتأكد من الموثوقية والأمان.",
    icon: "💡"
  }
];

// روابط التواصل
const whatsappNumber = "967775489714";
const whatsappLink = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent("مرحباً زيد، أود الاستفسار عن خدماتك البرمجية والحلول الذكية.")}`;
const telegramLink = "https://t.me/zaid2025026";
---

<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <title>زيد | Software & FinTech Developer</title>
    
    <!-- محرك التنسيقات Tailwind المباشر والمضمون 100% -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;700&display=swap" rel="stylesheet">
  </head>
  <body class="bg-slate-950 text-slate-100 font-['Tajawal',sans-serif] min-h-screen selection:bg-blue-600 selection:text-white relative">
    
    <!-- Navigation -->
    <header class="max-w-6xl mx-auto p-6 flex justify-between items-center border-b border-slate-800/80 sticky top-0 bg-slate-950/80 backdrop-blur-md z-40">
      <div class="text-2xl font-bold text-blue-500 tracking-wide">زيد<span class="text-white">.Dev</span></div>
      <nav class="space-x-6 space-x-reverse hidden md:flex text-slate-300 font-medium">
        <a href="#projects" class="hover:text-blue-400 transition">الأعمال</a>
        <a href="#services" class="hover:text-blue-400 transition">الخدمات</a>
        <a href="#contact" class="hover:text-blue-400 transition">التواصل</a>
      </nav>
      <a href={whatsappLink} target="_blank" class="bg-emerald-600 hover:bg-emerald-500 text-white px-5 py-2.5 rounded-xl font-bold transition flex items-center gap-2 shadow-lg shadow-emerald-600/20">
        💬 تواصل عبر واتساب
      </a>
    </header>

    <!-- Hero Section -->
    <section class="max-w-6xl mx-auto px-6 py-20 text-center md:text-right flex flex-col md:flex-row items-center justify-between gap-12">
      <div class="md:w-2/3 space-y-6">
        <div class="inline-flex items-center gap-2 bg-blue-950/80 text-blue-400 px-4 py-1.5 rounded-full text-sm font-semibold border border-blue-800/50">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          مطور أنظمة برمجية وحلول مالية وبوتات ذكاء اصطناعي ⚡
        </div>
        <h1 class="text-4xl md:text-6xl font-bold leading-tight">
          أحوّل التحديات المعقدة إلى <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-indigo-400">أنظمة برمجية ذكية</span>
        </h1>
        <p class="text-slate-400 text-lg md:text-xl leading-relaxed">
          أساعد الشركات والمؤسسات في أتمتة أعمالها وتطوير منصات ويب آمنة ومخصصة تجمع بين قوة الأداء والدقة المالية وربط أنظمة الرد الآلي (الذكاء الاصطناعي).
        </p>
        <div class="flex flex-col sm:flex-row gap-4 pt-4 justify-center md:justify-start">
          <a href={whatsappLink} target="_blank" class="bg-emerald-600 hover:bg-emerald-500 text-white px-8 py-3.5 rounded-xl font-bold text-center transition shadow-lg shadow-emerald-600/20 flex items-center justify-center gap-2">
            💬 تواصل مباشرة (775489714)
          </a>
          <a href="#projects" class="border border-slate-700 hover:border-slate-500 text-slate-300 px-8 py-3.5 rounded-xl font-bold text-center transition">
            استكشف أعمالي
          </a>
        </div>
      </div>

      <div class="md:w-1/3 flex justify-center">
        <div class="relative w-72 h-72 md:w-80 md:h-80 rounded-3xl p-1 bg-gradient-to-tr from-blue-600 via-indigo-600 to-emerald-500 shadow-2xl shadow-blue-500/20 group">
          <img 
            src={`${import.meta.env.BASE_URL}hero-img.jpg`}
            alt="زيد - مطور أنظمة وحلول مالية" 
            class="w-full h-full object-cover rounded-[22px] border border-slate-800 transition transform group-hover:scale-[1.02]"
          />
        </div>
      </div>
    </section>

    <!-- Projects Section -->
    <section id="projects" class="max-w-6xl mx-auto px-6 py-16 border-t border-slate-800/80">
      <div class="mb-12 text-center md:text-right">
        <h2 class="text-3xl font-bold text-white mb-3">معرض الأعمال والمشاريع</h2>
        <p class="text-slate-400">نماذج تطبيقية تظهر الحلول التقنية والأتمتة التي قمت بتطويرها:</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {projects.map((item) => (
          <div class="bg-slate-900/60 border border-slate-800 hover:border-blue-500/50 rounded-2xl p-6 transition flex flex-col justify-between group hover:-translate-y-1">
            <div>
              <div class="text-4xl mb-4 p-3 bg-slate-950 w-fit rounded-xl border border-slate-800 group-hover:scale-110 transition">
                {item.icon}
              </div>
              <h3 class="text-xl font-bold text-white mb-3">{item.title}</h3>
              <p class="text-slate-400 text-sm leading-relaxed mb-6">{item.description}</p>
            </div>
            
            <div>
              <div class="flex flex-wrap gap-2 mb-6">
                {item.tags.map((tag) => (
                  <span class="bg-blue-950/80 text-blue-300 text-xs px-2.5 py-1 rounded-md border border-blue-900/40">
                    {tag}
                  </span>
                ))}
              </div>
              <a href={item.link} target="_blank" class="block text-center bg-slate-950 hover:bg-blue-600 text-slate-200 hover:text-white py-2.5 rounded-xl text-sm font-semibold transition border border-slate-800">
                عرض الكود / التفاصيل ➔
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Services Section -->
    <section id="services" class="max-w-6xl mx-auto px-6 py-16 border-t border-slate-800/80">
      <div class="mb-12 text-center md:text-right">
        <h2 class="text-3xl font-bold text-white mb-3">الخدمات التي أقدمها</h2>
        <p class="text-slate-400">حلول مخصصة لمساعدتك في أتمتة وبناء مشروعك بأعلى كفاءة:</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {services.map((s) => (
          <div class="bg-slate-900/40 border border-slate-800/80 p-8 rounded-2xl hover:border-slate-700 transition flex gap-6 items-start">
            <div class="text-4xl p-4 bg-blue-950/40 rounded-2xl border border-blue-900/30 text-blue-400">
              {s.icon}
            </div>
            <div>
              <h3 class="text-xl font-bold text-white mb-2">{s.title}</h3>
              <p class="text-slate-400 text-sm leading-relaxed">{s.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="max-w-6xl mx-auto px-6 py-20 border-t border-slate-800/80">
      <div class="bg-gradient-to-br from-slate-900 via-slate-900 to-blue-950/40 border border-slate-800 rounded-3xl p-8 md:p-12 flex flex-col md:flex-row items-center justify-between gap-8 shadow-xl">
        <div class="space-y-4 text-center md:text-right md:w-2/3">
          <h2 class="text-3xl font-bold text-white">هل لديك مشروع او فكرة تريد تحويلها الى نظام يوفر الوقت والجهد أو تريد ربط بوت ذكاء اصطناعي يرد على استفسارات العملاء بدل منك في اي وقت؟</h2>
          <p class="text-slate-300 leading-relaxed">
            تواصل معي مباشرة لمناقشة فكرتك، تطوير أتمتة واتساب وتليجرام، أو بناء نظامك التقني بكفاءة عالية.
          </p>
          <div class="text-slate-400 font-mono text-sm text-right">
            📞 <span class="inline-block [direction:ltr]">+967 775 489 714</span>
          </div>
        </div>
        <div class="flex flex-col sm:flex-row gap-4 w-full md:w-auto justify-center">
          <a href={whatsappLink} target="_blank" class="bg-emerald-600 hover:bg-emerald-500 text-white px-6 py-3.5 rounded-xl font-bold text-center transition flex items-center justify-center gap-2 shadow-lg shadow-emerald-600/20">
            💬 محادثة واتساب
          </a>
          <a href={telegramLink} target="_blank" class="bg-sky-600 hover:bg-sky-500 text-white px-6 py-3.5 rounded-xl font-bold text-center transition flex items-center justify-center gap-2 shadow-lg shadow-sky-600/20">
            ✈️ تليجرام
          </a>
          <a href="https://github.com/zaid2025026" target="_blank" class="bg-slate-800 hover:bg-slate-700 border border-slate-700 text-white px-6 py-3.5 rounded-xl font-bold text-center transition flex items-center justify-center gap-2">
            GitHub ➔
          </a>
        </div>
      </div>
    </section>

    <!-- Floating WhatsApp Button -->
    <a href={whatsappLink} target="_blank" aria-label="WhatsApp" class="fixed bottom-6 right-6 bg-emerald-500 hover:bg-emerald-400 text-white p-4 rounded-full shadow-2xl z-50 transition transform hover:scale-110 flex items-center justify-center border-2 border-white/20">
      <span class="text-2xl">💬</span>
    </a>

    <!-- Footer -->
    <footer class="border-t border-slate-800/80 py-8 text-center text-slate-500 text-sm">
      <p>© 2026 زيد. جميع الحقوق محفوظة.</p>
    </footer>

  </body>
</html>