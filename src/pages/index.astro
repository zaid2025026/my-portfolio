---
import '../styles/global.css';

const projects = [
  {
    number: "01",
    title: "المنصة الإلكترونية الذكية",
    subtitle: "My Store & Telegram",
    problem:
      "إدارة الطلبات والمتابعة اليدوية قد تسبب تأخيرًا في التعامل مع العملاء وصعوبة في متابعة الطلبات الجديدة.",
    solution:
      "تم بناء متجر إلكتروني باستخدام Django مع ربط Telegram لإرسال تنبيهات الطلبات والفواتير بشكل آلي.",
    result:
      "تحويل عملية الطلب والمتابعة إلى سير عمل أكثر تنظيمًا، مع وصول التنبيهات مباشرة دون الحاجة إلى المتابعة اليدوية المستمرة.",
    tags: [
      "Python",
      "Django",
      "Telegram API",
      "SQLite / PostgreSQL"
    ],
    link: "https://github.com/zaid2025026/my_store",
    icon: "🛒"
  },
  {
    number: "02",
    title: "نظام الرقابة وتقييم الائتمان",
    subtitle: "Credit Risk System",
    problem:
      "تحليل البيانات المالية ومتابعة المخاطر الائتمانية يدويًا يجعل الوصول إلى المعلومات المهمة واتخاذ القرار أكثر صعوبة.",
    solution:
      "تم تصميم ونمذجة نظام مصرفي لتحليل البيانات المالية ومتابعة القروض والمخاطر باستخدام قواعد البيانات والمؤشرات المالية.",
    result:
      "تحويل البيانات المالية إلى معلومات ومؤشرات أوضح تساعد على المتابعة والتحليل ودعم اتخاذ القرار.",
    tags: [
      "SQL",
      "PL/SQL",
      "Oracle APEX",
      "Risk Analysis"
    ],
    link: "https://github.com/zaid2025026",
    icon: "🏦"
  },
  {
    number: "03",
    title: "المساعد الآلي السحابي",
    subtitle: "Cloud Automated Bot",
    problem:
      "جمع المعلومات وتحديث البيانات وإرسال التنبيهات بشكل يدوي يستهلك الوقت ويتطلب متابعة مستمرة.",
    solution:
      "تم تطوير بوت آلي يعمل على بيئة سحابية لجلب البيانات وجدولتها ومعالجتها وإرسال التحديثات تلقائيًا.",
    result:
      "أتمتة المهام المتكررة وتقليل الحاجة إلى التدخل اليدوي مع تشغيل النظام بشكل مستمر.",
    tags: [
      "Python",
      "Replit",
      "Automation",
      "RSS"
    ],
    link: "https://github.com/zaid2025026",
    icon: "🤖"
  }
];

const services = [
  {
    title: "تطوير تطبيقات الويب والأنظمة",
    desc:
      "بناء منصات ويب وأنظمة إدارية مخصصة باستخدام Python وDjango، مع تصميم واضح ولوحات تحكم تساعد على إدارة العمليات بكفاءة.",
    icon: "🌐"
  },
  {
    title: "أتمتة الأعمال والبوتات",
    desc:
      "تحويل المهام المتكررة إلى عمليات آلية وربط الأنظمة مع Telegram وWhatsApp وواجهات APIs لتوفير الوقت والجهد.",
    icon: "⚡"
  },
  {
    title: "هندسة وإدارة قواعد البيانات",
    desc:
      "تصميم قواعد البيانات والاستعلامات وتطوير حلول SQL وPL/SQL للأنظمة الإدارية والمالية.",
    icon: "📊"
  },
  {
    title: "الحلول الذكية والذكاء الاصطناعي",
    desc:
      "دمج أدوات الذكاء الاصطناعي مع الأنظمة والبوتات للمساعدة في الرد على العملاء ومعالجة المعلومات وأتمتة سير العمل.",
    icon: "🤖"
  }
];

const whatsappNumber = "967775489714";

const whatsappMessage =
  "مرحباً زيد، أود الاستفسار عن خدماتك البرمجية والحلول الذكية.";

const whatsappLink =
  `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;

const telegramLink = "https://t.me/zaid2025026";

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<html lang="ar" dir="rtl" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta
      name="description"
      content="زيد - مطور Python وDjango متخصص في بناء الأنظمة المخصصة وأتمتة الأعمال والحلول التقنية."
    />

    <link
      rel="icon"
      type="image/x-icon"
      href={`${baseUrl}favicon.ico`}
    />

    <title>زيد | Software & FinTech Developer</title>

    <link
      href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&display=swap"
      rel="stylesheet"
    />
  </head>

  <body
    class="bg-slate-950 text-slate-100 font-['Tajawal',sans-serif] min-h-screen selection:bg-blue-600 selection:text-white"
  >

    <!-- =========================
         NAVIGATION
    ========================== -->

    <header
      class="max-w-6xl mx-auto px-4 md:px-6 py-4 flex justify-between items-center border-b border-slate-800/80 sticky top-0 bg-slate-950/90 backdrop-blur-md z-40"
    >
      <div class="text-2xl font-bold text-blue-500 tracking-wide">
        زيد<span class="text-white">.Dev</span>
      </div>

      <nav class="hidden md:flex gap-7 text-slate-300 font-medium">
        <a
          href="#projects"
          class="hover:text-blue-400 transition"
        >
          المشاريع
        </a>

        <a
          href="#services"
          class="hover:text-blue-400 transition"
        >
          الخدمات
        </a>

        <a
          href="#contact"
          class="hover:text-blue-400 transition"
        >
          التواصل
        </a>
      </nav>

      <a
        href={whatsappLink}
        target="_blank"
        rel="noopener noreferrer"
        class="bg-emerald-600 hover:bg-emerald-500 text-white px-4 py-2 md:px-5 md:py-2.5 rounded-xl font-bold text-sm md:text-base transition flex items-center gap-2 shadow-lg shadow-emerald-600/20"
      >
        <span>💬</span>
        <span class="hidden sm:inline">تواصل عبر</span>
        واتساب
      </a>
    </header>


    <!-- =========================
         HERO
    ========================== -->

    <section
      class="max-w-6xl mx-auto px-6 py-16 md:py-24 flex flex-col md:flex-row items-center justify-between gap-12"
    >

      <div class="md:w-2/3 space-y-6 text-center md:text-right">

        <div
          class="inline-flex items-center gap-2 bg-blue-950/80 text-blue-400 px-4 py-1.5 rounded-full text-sm font-semibold border border-blue-800/50"
        >
          <span
            class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"
          ></span>

          متاح حاليًا لمشاريع جديدة
        </div>


        <h1
          class="text-4xl md:text-6xl font-bold leading-tight"
        >
         _ أبني

          <span
            class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-indigo-400"
          >
            أنظمة ويب مخصصة
          </span>

          تساعد أعمالك على العمل بشكل أسرع
        </h1>


        <p
          class="text-slate-400 text-lg md:text-xl leading-relaxed max-w-3xl"
        >
          مطور Python وDjango متخصص في بناء الأنظمة الإدارية
          والمنصات المخصصة وأتمتة الأعمال وربط الخدمات عبر APIs.
          أحوّل فكرتك أو العملية اليدوية إلى نظام عملي قابل للاستخدام.
        </p>


        <div
          class="flex flex-col sm:flex-row gap-4 pt-4 justify-center md:justify-start"
        >

          <a
            href={whatsappLink}
            target="_blank"
            rel="noopener noreferrer"
            class="bg-emerald-600 hover:bg-emerald-500 text-white px-8 py-3.5 rounded-xl font-bold text-center transition shadow-lg shadow-emerald-600/20 flex items-center justify-center gap-2"
          >
            💬 لدي مشروع — تحدث معي
          </a>

          <a
            href="#projects"
            class="border border-slate-700 hover:border-blue-500 text-slate-300 hover:text-white px-8 py-3.5 rounded-xl font-bold text-center transition"
          >
            مشاهدة أعمالي
          </a>

        </div>


        <div
          class="flex flex-wrap gap-4 pt-3 justify-center md:justify-start text-sm text-slate-500"
        >
          <span>✓ Python & Django</span>
          <span>✓ APIs & Automation</span>
          <span>✓ أنظمة إدارية ومالية</span>
        </div>

      </div>


      <!-- PROFILE IMAGE -->

      <div class="md:w-1/3 flex justify-center">

        <div
          class="relative w-64 h-64 sm:w-72 sm:h-72 md:w-80 md:h-80 rounded-3xl p-1 bg-gradient-to-tr from-blue-600 via-indigo-600 to-emerald-500 shadow-2xl shadow-blue-500/20 group"
        >

          <img
            src={`${baseUrl}hero-img.jpg`}
            alt="زيد - مطور Python وDjango"
            class="w-full h-full object-cover rounded-[22px] border border-slate-800 transition transform group-hover:scale-[1.02]"
            loading="eager"
          />

        </div>

      </div>

    </section>


    <!-- =========================
         PROJECTS
    ========================== -->

    <section
      id="projects"
      class="max-w-6xl mx-auto px-6 py-20 border-t border-slate-800/80"
    >

      <div class="mb-14 text-center">

        <div
          class="text-blue-400 text-sm font-bold mb-3 tracking-wide"
        >
          أعمالي
        </div>

        <h2
          class="text-3xl md:text-4xl font-bold text-white mb-4"
        >
          مشاريع مبنية لحل مشاكل حقيقية
        </h2>

        <p
          class="text-slate-400 max-w-2xl mx-auto leading-relaxed"
        >
          لا أركز فقط على كتابة الكود، بل على فهم المشكلة
          وتحويلها إلى حل تقني واضح يمكن استخدامه والاستفادة منه.
        </p>

      </div>


      <div class="grid grid-cols-1 lg:grid-cols-3 gap-7">

        {projects.map((item) => (

          <article
            class="bg-slate-900/70 border border-slate-800 hover:border-blue-500/60 rounded-3xl p-6 transition duration-300 flex flex-col group hover:-translate-y-1 shadow-xl shadow-black/10"
          >

            <!-- PROJECT HEADER -->

            <div class="flex items-start justify-between gap-4 mb-6">

              <div
                class="w-14 h-14 flex items-center justify-center text-3xl bg-slate-950 rounded-2xl border border-slate-800 group-hover:border-blue-500/40 transition"
              >
                {item.icon}
              </div>

              <span
                class="text-blue-500/60 font-bold text-sm"
              >
                {item.number}
              </span>

            </div>


            <h3
              class="text-xl font-bold text-white mb-1"
            >
              {item.title}
            </h3>


            <p
              class="text-blue-400 text-sm font-medium mb-6"
            >
              {item.subtitle}
            </p>


            <!-- PROBLEM -->

            <div class="mb-5">

              <div
                class="flex items-center gap-2 mb-2"
              >
                <span
                  class="w-2 h-2 rounded-full bg-red-400"
                ></span>

                <h4
                  class="text-sm font-bold text-slate-200"
                >
                  المشكلة
                </h4>
              </div>

              <p
                class="text-slate-400 text-sm leading-7"
              >
                {item.problem}
              </p>

            </div>


            <!-- SOLUTION -->

            <div class="mb-5">

              <div
                class="flex items-center gap-2 mb-2"
              >
                <span
                  class="w-2 h-2 rounded-full bg-blue-400"
                ></span>

                <h4
                  class="text-sm font-bold text-slate-200"
                >
                  الحل
                </h4>
              </div>

              <p
                class="text-slate-400 text-sm leading-7"
              >
                {item.solution}
              </p>

            </div>


            <!-- RESULT -->

            <div class="mb-6">

              <div
                class="flex items-center gap-2 mb-2"
              >
                <span
                  class="w-2 h-2 rounded-full bg-emerald-400"
                ></span>

                <h4
                  class="text-sm font-bold text-slate-200"
                >
                  النتيجة
                </h4>

              </div>

              <p
                class="text-slate-400 text-sm leading-7"
              >
                {item.result}
              </p>

            </div>


            <!-- TECHNOLOGIES -->

            <div class="mt-auto">

              <div
                class="text-xs font-bold text-slate-500 mb-3"
              >
                التقنيات المستخدمة
              </div>

              <div class="flex flex-wrap gap-2 mb-6">

                {item.tags.map((tag) => (

                  <span
                    class="bg-blue-950/70 text-blue-300 text-xs px-2.5 py-1.5 rounded-lg border border-blue-900/40"
                  >
                    {tag}
                  </span>

                ))}

              </div>


              <!-- PROJECT BUTTON -->

              <a
                href={item.link}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full flex items-center justify-center gap-2 bg-slate-950 hover:bg-blue-600 text-slate-200 hover:text-white py-3 rounded-xl text-sm font-bold transition border border-slate-800 hover:border-blue-500"
              >
                مشاهدة المشروع

                <span>←</span>
              </a>

            </div>

          </article>

        ))}

      </div>

    </section>


    <!-- =========================
         SERVICES
    ========================== -->

    <section
      id="services"
      class="max-w-6xl mx-auto px-6 py-20 border-t border-slate-800/80"
    >

      <div class="mb-12 text-center">

        <div
          class="text-blue-400 text-sm font-bold mb-3"
        >
          الخدمات
        </div>

        <h2
          class="text-3xl md:text-4xl font-bold text-white mb-4"
        >
          كيف يمكنني مساعدتك؟
        </h2>

        <p
          class="text-slate-400 max-w-2xl mx-auto"
        >
          حلول تقنية مخصصة تركز على تقليل العمل اليدوي
          وتحسين طريقة إدارة مشروعك.
        </p>

      </div>


      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

        {services.map((service) => (

          <div
            class="bg-slate-900/50 border border-slate-800/80 p-7 rounded-2xl hover:border-blue-500/40 transition flex gap-5 items-start"
          >

            <div
              class="text-3xl p-4 bg-blue-950/40 rounded-2xl border border-blue-900/30"
            >
              {service.icon}
            </div>

            <div>

              <h3
                class="text-xl font-bold text-white mb-3"
              >
                {service.title}
              </h3>

              <p
                class="text-slate-400 text-sm leading-7"
              >
                {service.desc}
              </p>

            </div>

          </div>

        ))}

      </div>

    </section>


    <!-- =========================
         CONTACT
    ========================== -->

    <section
      id="contact"
      class="max-w-6xl mx-auto px-6 py-20 border-t border-slate-800/80"
    >

      <div
        class="bg-gradient-to-br from-slate-900 via-slate-900 to-blue-950/40 border border-slate-800 rounded-3xl p-8 md:p-12 flex flex-col md:flex-row items-center justify-between gap-10 shadow-xl"
      >

        <div
          class="space-y-5 text-center md:text-right md:w-2/3"
        >

          <div
            class="text-blue-400 text-sm font-bold"
          >
            لنبدأ مشروعك
          </div>

          <h2
            class="text-3xl md:text-4xl font-bold text-white leading-tight"
          >
            لديك فكرة أو عملية يدوية تريد تحويلها إلى نظام؟
          </h2>

          <p
            class="text-slate-300 leading-7"
          >
            أخبرني عن المشكلة التي تواجهها، وسنبحث عن طريقة
            مناسبة لتحويلها إلى حل تقني يوفر الوقت والجهد
            ويساعد على تحسين سير العمل.
          </p>

          <div
            class="text-slate-400 font-mono text-sm"
          >
            📞
            <span class="inline-block [direction:ltr]">
              +967 775 489 714
            </span>
          </div>

        </div>


        <div
          class="flex flex-col sm:flex-row md:flex-col gap-3 w-full md:w-auto"
        >

          <a
            href={whatsappLink}
            target="_blank"
            rel="noopener noreferrer"
            class="bg-emerald-600 hover:bg-emerald-500 text-white px-7 py-3.5 rounded-xl font-bold text-center transition flex items-center justify-center gap-2 shadow-lg shadow-emerald-600/20"
          >
            💬 محادثة واتساب
          </a>

          <a
            href={telegramLink}
            target="_blank"
            rel="noopener noreferrer"
            class="bg-sky-600 hover:bg-sky-500 text-white px-7 py-3.5 rounded-xl font-bold text-center transition flex items-center justify-center gap-2"
          >
            ✈️ تليجرام
          </a>

          <a
            href="https://github.com/zaid2025026"
            target="_blank"
            rel="noopener noreferrer"
            class="bg-slate-800 hover:bg-slate-700 border border-slate-700 text-white px-7 py-3.5 rounded-xl font-bold text-center transition"
          >
            GitHub →
          </a>

        </div>

      </div>

    </section>


    <!-- =========================
         FLOATING WHATSAPP
    ========================== -->

    <a
      href={whatsappLink}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="WhatsApp"
      class="fixed bottom-6 right-6 bg-emerald-500 hover:bg-emerald-400 text-white p-4 rounded-full shadow-2xl z-50 transition transform hover:scale-110 flex items-center justify-center border-2 border-white/20"
    >
      <span class="text-2xl">💬</span>
    </a>


    <!-- =========================
         FOOTER
    ========================== -->

    <footer
      class="border-t border-slate-800/80 py-8 text-center text-slate-500 text-sm"
    >
      <p>
        © 2026 زيد. جميع الحقوق محفوظة.
      </p>
    </footer>

  </body>
</html>