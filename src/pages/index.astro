---
// src/pages/index.astro
import '../styles/global.css';

// 1. بيانات المشاريع
const projects = [
  {
    title: "المنصة الإلكترونية الذكية (My Store & Telegram)",
    description: "متجر إلكتروني متكامل باستخدام Django مع ربط مباشر ومؤتمت لتنبيهات الطلبات والفواتير عبر Telegram API.",
    tags: ["Python", "Django", "Telegram API", "SQLite/PostgreSQL"],
    link: "https://github.com/zaid2025026/my_store",
    icon: "🛒"
  },
  {
    title: "نظام الرقابة وتقييم الائتمان (Credit Risk System)",
    description: "تصميم ونمذجة نظام بنكي لتحليل الجدارة الائتمانية ومراقبة القروض المتعثرة بناءً على المؤشرات المالية وقواعد البيانات.",
    tags: ["SQL", "PL/SQL", "Oracle APEX", "Risk Analysis"],
    link: "https://github.com/zaid2025026",
    icon: "🏦"
  },
  {
    title: "المساعد الآلي السحابي (Cloud Automated Bot)",
    description: "تطوير ونشر بوت آلي على بيئة Replit يعمل على مدار الساعة لجلب وجدولة البيانات وإرسال التحديثات آلياً.",
    tags: ["Python", "Replit", "Automation", "RSS Parsers"],
    link: "https://github.com/zaid2025026",
    icon: "🤖"
  }
];

// 2. بيانات الخدمات
const services = [
  {
    title: "تطوير تطبيقات الويب والأنظمة",
    desc: "بناء منصات ويب آمنة ومخصصة بأعلى مستويات الأداء باستخدام Python و Django مع لوحات تحكم متكاملة.",
    icon: "🌐"
  },
  {
    title: "أتمتة الأعمال وبناء البوتات",
    desc: "ربط الخدمات والمتاجر ببوتات تفاعلية ذكية (تليجرام/واتساب) وتوفير وقت الإدخال اليدوي.",
    icon: "⚡"
  },
  {
    title: "هندسة وإدارة قواعد البيانات",
    desc: "تصميم الاستعلامات المعقدة وتطوير معمارية قواعد البيانات (SQL / PL-SQL) للأنظمة المالية والإدارية.",
    icon: "📊"
  },
  {
    title: "استشارات الأنظمة التقنية والمالية",
    desc: "تقييم المتطلبات البرمجية واختيار المعمارية الأنسب لمشروعك قبل البدء للتأكد من الموثوقية والأمان.",
    icon: "💡"
  }
];
---

<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <title>زيد | Software & FinTech Developer</title>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;700&display=swap" rel="stylesheet">
  </head>
  <body class="bg-slate-900 text-slate-100 font-['Tajawal',sans-serif] min-h-screen selection:bg-blue-600 selection:text-white">
    
    <!-- Navigation -->
    <header class="max-w-6xl mx-auto p-6 flex justify-between items-center border-b border-slate-800">
      <div class="text-2xl font-bold text-blue-500">زيد<span class="text-white">.Dev</span></div>
      <nav class="space-x-6 space-x-reverse hidden md:flex text-slate-300">
        <a href="#projects" class="hover:text-blue-400 transition">الأعمال</a>
        <a href="#services" class="hover:text-blue-400 transition">الخدمات</a>
        <a href="#contact" class="hover:text-blue-400 transition">التواصل</a>
      </nav>
      <a href="#contact" class="bg-blue-600 hover:bg-blue-500 text-white px-4 py-2 rounded-lg font-medium transition">
        تواصل معي
      </a>
    </header>

    <!-- Hero Section -->
    <section class="max-w-6xl mx-auto px-6 py-20 text-center md:text-right flex flex-col md:flex-row items-center justify-between gap-12">
      <div class="md:w-2/3 space-y-6">
        <div class="inline-block bg-blue-950 text-blue-400 px-4 py-1.5 rounded-full text-sm font-semibold border border-blue-800/50">
          مطور أنظمة برمجية وحلول مالية ⚡
        </div>
        <h1 class="text-4xl md:text-6xl font-bold leading-tight">
          أحوّل التحديات المعقدة إلى <span class="text-blue-500">أنظمة برمجية ذكية</span>
        </h1>
        <p class="text-slate-400 text-lg md:text-xl leading-relaxed">
          أساعد الشركات والمؤسسات في أتمتة أعمالها وتطوير منصات ويب آمنة ومخصصة تجمع بين قوة الأداء والدقة المالية.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 pt-4 justify-center md:justify-start">
          <a href="#projects" class="bg-blue-600 hover:bg-blue-500 text-white px-8 py-3 rounded-xl font-bold text-center transition shadow-lg shadow-blue-600/20">
            استكشف أعمالي
          </a>
          <a href="#contact" class="border border-slate-700 hover:border-slate-500 text-slate-300 px-8 py-3 rounded-xl font-bold text-center transition">
            حجز استشارة
          </a>
        </div>
      </div>

      <div class="md:w-1/3 flex justify-center">
        <div class="w-64 h-64 rounded-2xl bg-gradient-to-tr from-blue-600 to-indigo-900 flex items-center justify-center p-1 shadow-2xl">
          <div class="w-full h-full bg-slate-900 rounded-2xl flex flex-col items-center justify-center p-6 text-center border border-slate-800">
            <span class="text-5xl mb-4">💻</span>
            <span class="font-bold text-lg">Zaid | زيد</span>
            <span class="text-xs text-slate-400 mt-1">Python • Django • SQL • AI</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Projects Section -->
    <section id="projects" class="max-w-6xl mx-auto px-6 py-16 border-t border-slate-800">
      <div class="mb-12 text-center md:text-right">
        <h2 class="text-3xl font-bold text-white mb-3">معرض الأعمال والمشاريع</h2>
        <p class="text-slate-400">نماذج تطبيقية تظهر الحلول التقنية والأتمتة التي قمت بتطويرها:</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {projects.map((item) => (
          <div class="bg-slate-800/50 border border-slate-700/60 hover:border-blue-500/50 rounded-2xl p-6 transition flex flex-col justify-between group">
            <div>
              <div class="text-4xl mb-4 p-3 bg-slate-900 w-fit rounded-xl border border-slate-800 group-hover:scale-110 transition">
                {item.icon}
              </div>
              <h3 class="text-xl font-bold text-white mb-3">{item.title}</h3>
              <p class="text-slate-400 text-sm leading-relaxed mb-6">{item.description}</p>
            </div>
            
            <div>
              <div class="flex flex-wrap gap-2 mb-6">
                {item.tags.map((tag) => (
                  <span class="bg-blue-950 text-blue-300 text-xs px-2.5 py-1 rounded-md border border-blue-900/40">
                    {tag}
                  </span>
                ))}
              </div>
              <a href={item.link} target="_blank" class="block text-center bg-slate-900 hover:bg-blue-600 text-slate-200 hover:text-white py-2.5 rounded-xl text-sm font-semibold transition border border-slate-700">
                عرض الكود / التفاصيل ➔
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Services Section -->
    <section id="services" class="max-w-6xl mx-auto px-6 py-16 border-t border-slate-800">
      <div class="mb-12 text-center md:text-right">
        <h2 class="text-3xl font-bold text-white mb-3">الخدمات التي أقدمها</h2>
        <p class="text-slate-400">حلول مخصصة لمساعدتك في أتمتة وبناء مشروعك بأعلى كفاءة:</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {services.map((s) => (
          <div class="bg-slate-800/30 border border-slate-800 p-8 rounded-2xl hover:border-slate-700 transition flex gap-6 items-start">
            <div class="text-4xl p-4 bg-blue-950/50 rounded-2xl border border-blue-900/30 text-blue-400">
              {s.icon}
            </div>
            <div>
              <h3 class="text-xl font-bold text-white mb-2">{s.title}</h3>
              <p class="text-slate-400 text-sm leading-relaxed">{s.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 5. Contact Section & Footer (اليوم الرابع) -->
    <section id="contact" class="max-w-6xl mx-auto px-6 py-20 border-t border-slate-800">
      <div class="bg-gradient-to-r from-blue-950/40 via-slate-800 to-slate-900 border border-blue-900/30 rounded-3xl p-8 md:p-12 flex flex-col md:flex-row items-center justify-between gap-8">
        <div class="space-y-4 text-center md:text-right md:w-2/3">
          <h2 class="text-3xl font-bold text-white">هل لديك مشروع أو فكرة تريد تنفيذها؟</h2>
          <p class="text-slate-300 leading-relaxed">
            دعنا نتناقش حول كيفية بناء وتطوير أنظمتك التقنية أو أتمتة عملياتك المالية بكفاءة وأمان.
          </p>
        </div>
        <div class="flex flex-col sm:flex-row gap-4 w-full md:w-auto justify-center">
          <a href="https://github.com/zaid2025026" target="_blank" class="bg-slate-800 hover:bg-slate-700 border border-slate-600 text-white px-6 py-3.5 rounded-xl font-bold text-center transition flex items-center justify-center gap-2">
            <span>GitHub Profile</span> ➔
          </a>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="border-t border-slate-800 py-8 text-center text-slate-500 text-sm">
      <p>© 2026 زيد. جميع الحقوق محفوظة.</p>
    </footer>

  </body>
</html>